# Copy to .env and fill in. Never commit .env.
# Keys: https://developer.ebay.com/my/keys   (use the PRODUCTION keyset)
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName ("eBay Redirect URL name") from developer.ebay.com > User Tokens > "Get a Token from eBay via Your Application"
EBAY_RUNAME=

# Item location
EBAY_LOCATION_KEY=squamish-bc
EBAY_LOCATION_CITY=Squamish
EBAY_LOCATION_PROVINCE=BC
EBAY_LOCATION_POSTAL=

# Listings are on eBay.com in USD. Shipping is flat rate in USD, from Canada.
# CA_Post... codes only work on eBay.ca. Check valid codes with: .venv/bin/python ebay_lister.py shipping-services
EBAY_HANDLING_DAYS=1
EBAY_SHIP_CA_SERVICE=StandardInternational
EBAY_SHIP_CA_COST=12.50
EBAY_SHIP_US_SERVICE=StandardShippingFromOutsideUS
EBAY_SHIP_US_COST=17.50
EBAY_SHIP_INTL_SERVICE=OtherInternational
EBAY_SHIP_INTL_COST=17.50

# Optional: use EBAY_US business policies you already have instead of creating new ones
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=

# Subtitles cost extra per listing on eBay. Set to true to include them.
EBAY_INCLUDE_SUBTITLE=false

# Claude (required): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
LISTER_MODEL=claude-opus-5-5
# Best-effort price lookups through Claude web search
LISTER_WEB_SEARCH=true

# Research (optional)
# PriceCharting paid API token. The only source here with TAG 10 and video game guide prices.
PRICECHARTING_TOKEN=
# Only if eBay has granted your account the Marketplace Insights (sold data) API
EBAY_INSIGHTS_ENABLED=false

# Pricing and timezone
LISTER_TIMEZONE=America/Vancouver
# Buy It Now price = market value x this
LISTER_BIN_MARKUP=1.05
# Auction start price, USD
LISTER_AUCTION_START=20
